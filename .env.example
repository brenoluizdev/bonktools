# Configuração do Bot
BOT_USERNAME=FUTHERO BOT
BOT_PASSWORD=

# Modo de jogo. Valores: mbappa1x1, mbappa2x2, classic1x1, grapple1x1, deatharrow1x1,
# blclassic, volei1x1, barkball, blbasketball, blvolleyball, corridacart
MODE=mbappa2x2

# Configuração da Sala (opcional). Salas sem senha por padrão.
ROOM_NAME=🔥 FUTHERO | X2 | FUTSAL 🔥
ROOM_NAME_MBAPPA_1X1=🔥 FUTHERO | MBAPPA 1x1 🔥
ROOM_NAME_MBAPPA_2X2=🔥 FUTHERO | X2 | MBAPPA 🔥
ROOM_NAME_CLASSIC_1X1=🔥 FUTHERO | Classic 1x1 🔥
ROOM_NAME_GRAPPLE_1X1=🔥 FUTHERO | Grapple 1v1 🔥
ROOM_NAME_DEATHARROW_1X1=🔥 FUTHERO | Death Arrow 1v1 🔥
ROOM_NAME_BL_CLASSIC=🔥 FUTHERO | BL Classic 🔥
ROOM_NAME_VOLEI_1X1=🔥 FUTHERO | Vôlei de rua 1x1 🔥
ROOM_NAME_BARKBALL=🔥 FUTHERO | Barkball 🔥
ROOM_NAME_BL_BASKETBALL=🔥 FUTHERO | BL Basketball 🔥
ROOM_NAME_BL_VOLLEYBALL=🔥 FUTHERO | BL Volleyball 🔥
ROOM_NAME_CORRIDA_CART=🔥 FUTHERO | Corrida de Cart 🔥
ROOM_PASSWORD=
ROOM_MAX_PLAYERS=8
ROOM_MIN_LEVEL=0
ROOM_HIDDEN=false
# Sala na lista pública (omitir ou false = visível; true = unlisted/escondida)
# ROOM_UNLISTED=true

# Link do Discord (comando !d / !discord)
# DISCORD_SERVER_LINK=https://discord.gg/...

# Webhook Discord (opcional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Log detalhado no terminal para diagnosticar problemas (BonkRoom + RoomMaker)
# Valores: 1 ou true para ativar
# BONK_DEBUG=1

# Navegador - Nova Implementação (bonk-rating-bot style)
# Modo headless (1 = sem janela, 0 = com janela visível)
HEADLESS=0

# Navegador padrão para testes: firefox = Firefox (via Playwright), omitir = Chromium (Puppeteer)
# Para Firefox: npm install playwright && npx playwright install firefox
BROWSER=

# Caminho do Chrome (opcional - só quando BROWSER não é firefox)
# Só preencha se quiser usar um Chrome específico
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux: /usr/bin/google-chrome
CHROME_PATH=

# ====== CONFIGURAÇÕES ANTIGAS (bonktools) ======
# Essas são do código antigo e não são mais necessárias
# para a nova implementação, mas mantidas por compatibilidade

# Iniciar navegador automaticamente? (true = sim, false = não)
AUTO_START_BROWSER=false

# Modo headless antigo
BROWSER_HEADLESS=false

# Modo de teste (opcional)
# TEST_BROWSER_START=0
