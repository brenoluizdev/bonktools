{
  "name": "bonktools",
  "version": "0.1.1",
  "description": "Headless TypeScript client for bonk.io — connects directly via Socket.IO, no browser required. Create/join rooms, manage rosters, and run 24/7 bots with automatic reconnection.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "bonktools-capture-is": "dist/cli/capture-is.js"
  },
  "files": [
    "dist",
    "certs"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "vitest watch",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "bonk.io",
    "bonkio",
    "bonk",
    "socket.io",
    "game-bot",
    "headless",
    "typescript",
    "bot",
    "automation",
    "websocket"
  ],
  "author": "brenoluizdev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brenoluizdev/bonktools.git"
  },
  "homepage": "https://github.com/brenoluizdev/bonktools#readme",
  "bugs": {
    "url": "https://github.com/brenoluizdev/bonktools/issues"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "pino": "^9.14.0",
    "socket.io-client": "~2.5.0",
    "undici": "^6.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "lz-string": "^1.5.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7",
    "vitest": "^2.1.9"
  }
}
